<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Judul / Identitas Tugas -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tugas Kondisional\nMas'ud Rifan Zamzen (24081024)\nTeknik Informatika - UHTP"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="20dp"/>

    <!-- Input Nilai -->
    <EditText
        android:id="@+id/ed_nilai_angka"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Masukkan Nilai Angka (contoh: 80)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="10dp"/>

    <!-- Tombol Proses -->
    <Button
        android:id="@+id/bt_proses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Proses"
        android:layout_marginBottom="10dp"/>

    <!-- Output Hasil -->
    <EditText
        android:id="@+id/ed_hasil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Keterangan Lulus/Gagal"
        android:focusable="false"
        android:clickable="false"
        android:textColor="@android:color/holo_blue_dark"
        android:textStyle="bold"/>

</LinearLayout>